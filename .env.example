# Local Postgres (Docker)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# Supabase (cloud) — swap these in when you want to hit the real DB
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=<from Supabase project settings → API>
SUPABASE_SERVICE_ROLE_KEY=<from Supabase project settings → API>
SUPABASE_DB_POOLER_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# App
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ISSUER=catms
JWT_AUDIENCE=catms-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=catms_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
